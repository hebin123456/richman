<?xml version="1.0" encoding="utf-8"?>
<!-- 允许访问本机内嵌 Node 服务的明文 HTTP(Android 9+ 默认禁止 cleartext) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>